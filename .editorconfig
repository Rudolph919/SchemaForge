root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# 'var' preferred when the type is apparent
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# member style
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning

# Naming: interfaces start with I
dotnet_naming_rule.interface_should_be_prefixed.severity = warning
dotnet_naming_rule.interface_should_be_prefixed.symbols = interface_symbol
dotnet_naming_rule.interface_should_be_prefixed.style = prefix_interface_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_interface_style.required_prefix = I
dotnet_naming_style.prefix_interface_style.capitalization = pascal_case

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
