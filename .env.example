# Copy to .env and adjust for local development. Never commit the real .env.

POSTGRES_DB=schemaforge
# Superuser - used for running migrations only, never by the running app (see docker-compose.yml).
POSTGRES_USER=schemaforge
POSTGRES_PASSWORD=changeme-local-only
# Restricted, non-superuser role the running app actually connects as, so Postgres RLS applies.
POSTGRES_APP_USER=schemaforge_app
POSTGRES_APP_PASSWORD=changeme-local-only-app

MINIO_ROOT_USER=schemaforge
MINIO_ROOT_PASSWORD=changeme-local-only

JWT_SIGNING_KEY=changeme-local-only-minimum-32-characters
